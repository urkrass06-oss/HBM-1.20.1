+// Preserve the upstream license in all produced archives.
+tasks.withType<Jar>().configureEach {
+	exclude("**/.cache/**")
+	from(rootProject.file("LICENSE")) { rename { "LICENSE.hbm_m" } }
+	isPreserveFileTimestamps = false
+	isReproducibleFileOrder = true
+}
+
+// Fletching Table also appends manually client/server-scoped mixins to the common list.
+// Preserve the existing side assignments when packaging the generated configuration.
+tasks.named<ProcessResources>("processResources") {
+    inputs.property("modernized.mixinSideFilter", 1)
+    doLast {
+        val configFile = destinationDir.resolve(prop("mod.mixin_config"))
+        @Suppress("UNCHECKED_CAST")
+        val config = JsonSlurper().parse(configFile) as MutableMap<String, Any?>
+        val sided = ((config["client"] as? List<*>) ?: emptyList<Any>()) +
+            ((config["server"] as? List<*>) ?: emptyList<Any>())
+        val common = config["mixins"] as List<*>
+        config["mixins"] = common.filterNot { it in sided }
+        configFile.writeText(JsonOutput.prettyPrint(JsonOutput.toJson(config)), Charsets.UTF_8)
+    }
+}
